# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# C extensions
*.so

# Distribution / packaging
# lib/ and lib64/ are scoped to the repo root only (not /lib, /lib64) -
# an unscoped `lib/` here silently ignored the entire, unrelated
# src/frontend/lib/ directory (real, actively-imported frontend source:
# types.ts, api.ts, combineTrees.ts, etc.) since it had never been added
# under this root-level Python-packaging rule. Found while committing a
# frontend change to src/frontend/lib/types.ts in the semantic-defect
# milestone - that whole directory had never been tracked by git.
.Python
/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#   Usually these files are written by a python script from a template
#   before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

